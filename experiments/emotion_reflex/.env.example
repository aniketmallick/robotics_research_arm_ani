# Emotion-reflex spike — optional overrides. Export these before launching, or
# copy the ones you need. All are read by spikeconfig.py (both processes).
# Nothing here touches the demo pipeline's .env or armani/config.py.

# --- camera ---
# OpenCV index of the LAPTOP built-in webcam. NOT the C920 (that one is locked to
# the arm's homography). `detector.py --watch` prints the indices that respond —
# confirm which one is the FaceTime cam before trusting this.
# ARMANI_REFLEX_CAM_INDEX=0
# ARMANI_REFLEX_CAM_MAX_PROBE=4

# --- detector debounce ---
# ARMANI_REFLEX_WINDOW=15            # rolling window, frames
# ARMANI_REFLEX_HOLD_S=1.0           # a class must hold the majority this long
# ARMANI_REFLEX_MIN_SCORE=0.55       # ...and clear this mean score, to emit
# ARMANI_REFLEX_WRITE_INTERVAL_S=0.25

# --- reflex (arm side) ---
# ARMANI_REFLEX_POLL_HZ=7.0
# ARMANI_REFLEX_STALE_S=3.0          # older state = "no emotion"
# ARMANI_REFLEX_COOLDOWN_S=15.0      # min seconds between reflex gestures
# ARMANI_REFLEX_ALLOW_REPEAT=0       # 1 = react every cooldown to a held emotion

# --- emotion -> gesture map ---
# Comma-separated emotion:gesture pairs. Gestures MUST be recorded ones:
# bow, wave, dance, nod_yes, shake_no, look_around, celebrate, sad_droop.
# Default: happy:nod_yes, sad:celebrate, surprise:look_around, angry:bow
# ARMANI_REFLEX_MAP=happy:nod_yes,sad:celebrate,surprise:look_around,angry:bow
