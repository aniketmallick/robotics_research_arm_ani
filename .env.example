# Copy to .env and fill in. .env is gitignored and must never be committed or printed.

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# --- Hardware, discovered per machine (see docs/env_report.md) ---
# Serial port of the SO-101 follower arm, e.g. /dev/tty.usbmodem5B3D0412751
ARMANI_FOLLOWER_PORT=
# Serial port of the SO-101 leader arm (not used until teleop-driven recording in stage 2)
ARMANI_LEADER_PORT=
# OpenCV index of the Logitech C920. Leave blank to be prompted by the smoke tests.
ARMANI_CAMERA_INDEX=

# Set to 1 to print intended motion instead of sending it to the motors.
# doctor.py refuses to start a LIVE run while this is set.
ARMANI_DRY_RUN=0

# --- Optional overrides (sensible defaults in armani/config.py) ---
# Calibration ids, as they exist under ~/.cache/huggingface/lerobot/calibration/
# ARMANI_FOLLOWER_ID=follower_arm
# ARMANI_LEADER_ID=leader_arm

# Gesture dataset. Only the ROOT actually matters to lerobot; the repo id is a
# label. lerobot-record appends _YYYYMMDD_HHMMSS to the repo id unless you pass
# --dataset.root, so set this if your recording landed somewhere unexpected.
# ARMANI_GESTURE_REPO_ID=anikmall/armani_gestures
# ARMANI_GESTURE_ROOT=/Users/you/.cache/huggingface/lerobot/anikmall/armani_gestures

# --- Stage 4: eyes, table geometry and calibration ---
# Height of the TABLE SURFACE in robot-base coordinates, metres. 0.0 means the
# arm's base sits on the same surface as the objects, which is the usual SO-101
# mounting. Mounted on a riser, this is NEGATIVE (the table is below the base) —
# which makes top-down reaching considerably easier. MEASURE IT.
# ARMANI_TABLE_HEIGHT_M=0.0

# How far above the table the gripper hovers. Stage 4 never goes below this.
# ARMANI_HOVER_HEIGHT_M=0.10

# How far inside the calibrated points the usable table polygon is pulled, metres.
# A homography extrapolates confidently and wrongly beyond its data.
# ARMANI_TABLE_MARGIN_M=0.02

# Refuse to save a homography whose mean reprojection error exceeds this, pixels.
# ARMANI_CALIB_MAX_REPROJ_PX=15

# ChArUco board, for `scripts/calibrate_camera.py --method charuco`.
# Generate one with `--print-board`, print at 100% scale, then MEASURE a square
# with a ruler: a wrong square length scales the entire map linearly.
# ARMANI_CHARUCO_SQUARES_X=5
# ARMANI_CHARUCO_SQUARES_Y=7
# ARMANI_CHARUCO_SQUARE_M=0.030
# ARMANI_CHARUCO_MARKER_M=0.022
# ARMANI_CHARUCO_DICT=DICT_4X4_50

# --- Stage 5: taught zones (the demo pick path) ---
# Recorded pick macros, one episode per zone, in the order define_zones.py printed.
# As with the gestures, only the ROOT matters to lerobot; the repo id is a label.
# lerobot-record appends _YYYYMMDD_HHMMSS unless you pass --dataset.root.
# ARMANI_PICK_REPO_ID=anikmall/armani_picks
# ARMANI_PICK_ROOT=/Users/you/.cache/huggingface/lerobot/anikmall/armani_picks

# How much closer the nearest marked spot must be than the runner-up before the
# assignment counts as settled. Inside this, the object is "between two spots"
# and stage 6 asks which one. Raise it to be more cautious, lower it if your
# spots are physically close together.
# ARMANI_ASSIGNMENT_MARGIN_PX=60

# Beyond this distance from EVERY spot, the object is not on a marked spot at
# all and the pick is refused rather than sent to the nearest one.
# ARMANI_ZONE_MAX_DISTANCE_PX=140

# Gripper percent (0 = fully closed) at or below which the jaws are assumed to
# have closed on nothing. Weak secondary signal only — calibrate it against what
# your recorded macros actually close to.
# ARMANI_GRIPPER_EMPTY_MAX_PCT=5

# --- Stage 6: trust gates ---
# G4's line. At or above this it states the number and picks; below it, it states
# the number and must get spoken approval first.
# ARMANI_CONF_APPROVAL=0.60

# G4's fail-closed deadline, seconds. No approval within this and the pending
# pick is DISCARDED. Enforced by gates.py's own clock.
# ARMANI_APPROVAL_TIMEOUT_S=10

# The confidence formula:
#   confidence = vision * (FLOOR + (1 - FLOOR) * clamp(margin_px / CLEAR_PX, 0, 1))
# Vision confidence says "that is a red block"; the assignment margin says how
# sure we are WHICH spot it is on. FLOOR stops a tight assignment from zeroing an
# otherwise certain detection.
# ARMANI_CONF_ASSIGNMENT_FLOOR=0.5
# ARMANI_CONF_CLEAR_MARGIN_PX=120

# G5: how sure the VLM must be before its verdict overrules the gripper reading.
# ARMANI_G5_MIN_CONFIDENCE=0.50

# How long a pick tool call waits for the gate pipeline's next event.
# ARMANI_PICK_EVENT_TIMEOUT_S=60
