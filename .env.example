# Copy to .env and fill in. .env is gitignored and must never be committed or printed.

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# --- Hardware, discovered per machine (see docs/env_report.md) ---
# Serial port of the SO-101 follower arm, e.g. /dev/tty.usbmodem5B3D0412751
ARMANI_FOLLOWER_PORT=
# Serial port of the SO-101 leader arm (not used until teleop-driven recording in stage 2)
ARMANI_LEADER_PORT=
# OpenCV index of the Logitech C920. Leave blank to be prompted by the smoke tests.
ARMANI_CAMERA_INDEX=

# Set to 1 to print intended motion instead of sending it to the motors.
ARMANI_DRY_RUN=0
